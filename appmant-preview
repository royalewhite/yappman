#!/data/data/com.termux/files/usr/bin/sh

if [ "$1" = '--help' ]; then
  cat <<'HELP'
Appman preview

The preview shows package identity, APK label, version, installation
metadata, and enabled/disabled state for the currently selected profile.

Tap the header tabs or use ALT-1 / ALT-2 to change Android users.
Use ALT-U / ALT-Y to change app type.
HELP
  exit 0
fi

user_id=$1
pkg=$2
[ -n "$user_id" ] && [ -n "$pkg" ] || exit 0

apk=$(sudo cmd package path "$pkg" 2>/dev/null | sed -n '1s/^package://p')
label=''
if [ -n "$apk" ]; then
  label=$(sudo /data/data/com.termux/files/usr/bin/aapt2 dump badging "$apk" 2>/dev/null |
    sed -n "s/^application-label:'\(.*\)'$/\1/p" | head -n 1)
fi

printf '\033[1;36m📦 %s\033[0m (\033[0;33m%s\033[0m)\n' "${label:-$pkg}" "$pkg"
printf 'Android user: %s\n' "$user_id"
printf '%s\n' '────────────────────────────────────────'

if sudo cmd package list packages --user "$user_id" -d "$pkg" 2>/dev/null | grep -q "^package:$pkg$"; then
  printf 'State: \033[1;36m Disabled / frozen\033[0m\n'
else
  printf 'State: \033[1;32mEnabled\033[0m\n'
fi

sudo dumpsys package "$pkg" 2>/dev/null |
  grep -E 'versionName=|firstInstallTime=|lastUpdateTime=|installerPackageName=' |
  sed 's/^[[:space:]]*//' |
  awk -F= '
    /^versionName=/ && !seen["versionName"]++ { print; next }
    /^firstInstallTime=/ && $2 !~ /^1970-01-01/ && !seen["firstInstallTime"]++ { print; next }
    /^lastUpdateTime=/ && !seen["lastUpdateTime"]++ { print; next }
    /^installerPackageName=/ && !seen["installerPackageName"]++ { print; next }
  ' | head -n 4
