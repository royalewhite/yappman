#!/data/data/com.termux/files/usr/bin/sh

# yappman — Android profile discovery
# Output: ID<TAB>LABEL<TAB>TYPE<TAB>NAME

output=$(sudo cmd user list -v 2>/dev/null)

if printf '%s\n' "$output" | grep -q 'id=[0-9]'; then
    printf '%s\n' "$output" | awk '
    {
        id = name = type = flags = ""

        if (match($0, /id=[0-9]+/))
            id = substr($0, RSTART + 3, RLENGTH - 3)

        if (match($0, /name=[^,]*/))
            name = substr($0, RSTART + 5, RLENGTH - 5)

        if (match($0, /type=[^,]*/))
            type = substr($0, RSTART + 5, RLENGTH - 5)

        if (match($0, /flags=[^)]*/))
            flags = substr($0, RSTART + 6, RLENGTH - 6)

        if (id == "") next

        if (id == "0")
            label = "U0"
        else if (flags ~ /SECURE_FOLDER/)
            label = "SECURE"
        else if (type ~ /profile[.]MANAGED/)
            label = "WORK"
        else if (type ~ /full/)
            label = "USER " id
        else
            label = "PROFILE " id

        printf "%s\t%s\t%s\t%s\n", id, label, type, name
    }'
else
    sudo cmd user list 2>/dev/null | awk '
    {
        line = $0

        while (match(line, /UserInfo\{[^}]+\}/)) {
            entry = substr(line, RSTART + 9, RLENGTH - 10)
            line = substr(line, RSTART + RLENGTH)

            n = split(entry, fields, ":")
            id = fields[1]
            name = fields[2]
            flags = fields[3]
            type = "unknown"

              if (id !~ /^[0-9]+$/) continue

            if (id == "0")
                label = "U0"
            else if (flags ~ /SECURE_FOLDER/)
                label = "SECURE"
            else if (flags ~ /MANAGED_PROFILE/)
                label = "WORK"
            else if (flags ~ /FULL/)
                label = "USER " id
            else
                label = "PROFILE " id

            printf "%s\t%s\t%s\t%s\n", id, label, type, name
        }
    }'
fi
